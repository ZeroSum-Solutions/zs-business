# Copy to .env.local (never committed). Leave ZS_API_URL empty to run on the in-memory
# demo data for Halden & Rowe Fine Jewelry.
#
# Both values are server-only. The browser calls the dashboard's own /api proxy, which
# adds the token on the server; nothing here is inlined into page JS (the build checks).
# Set them for `build` (it decides demo or live mode) and for `start` or `dev`.
ZS_API_URL=
# Bearer token the proxy sends, e.g. the dev JWT printed by `pnpm --filter @zs/api seed:demo`.
# That token lasts 7 days, so the API must run with JWT_MAX_TTL_SECONDS=604800 (as in
# apps/api/.env.example). The API needs no ALLOWED_ORIGINS entry: the browser never calls it.
ZS_API_TOKEN=

# Pilot gate (live mode only; the demo needs none). The proxy and /api/session serve only a
# browser that signed in at /sign-in with this code. Live mode refuses every request while
# either value is missing or too short. Generate them, e.g. `openssl rand -base64 24` and
# `openssl rand -hex 32`. Read at request time, so set them for `start` or `dev`, not `build`.
# Shared access code, at least 16 characters.
DASHBOARD_ACCESS_CODE=
# Signs the session cookie, at least 32 characters. Changing it (or the code) signs everyone out.
DASHBOARD_SESSION_SECRET=
# How long a sign-in lasts, in seconds (60 to 604800). Default 43200 (12 hours).
DASHBOARD_SESSION_TTL_SECONDS=
# Set to 1 only behind a reverse proxy that sets X-Forwarded-Host, -Proto and -For. Then the
# origin check uses X-Forwarded-Host, the cookie is Secure when X-Forwarded-Proto is https,
# and sign-in rate limits key on the address the proxy saw. Leave empty otherwise.
DASHBOARD_TRUST_PROXY=
