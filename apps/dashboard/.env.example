# Copy to .env.local (never committed). Leave NEXT_PUBLIC_API_URL empty to run on the
# in-memory demo data for Halden & Rowe Fine Jewelry.
NEXT_PUBLIC_API_URL=
# Dev-only bearer token printed by `pnpm --filter @zs/api seed:demo`. It ships to the
# browser, so use a local dev token only. Add the dashboard origin (http://localhost:3200)
# to the API's ALLOWED_ORIGINS.
NEXT_PUBLIC_API_TOKEN=
