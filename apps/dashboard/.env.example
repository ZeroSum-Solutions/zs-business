# Copy to .env.local (never committed). Leave NEXT_PUBLIC_API_URL empty to run on the
# in-memory demo data for Halden & Rowe Fine Jewelry.
NEXT_PUBLIC_API_URL=
# Dev-only bearer token printed by `pnpm --filter @zs/api seed:demo`. It ships to the
# browser, so use a local dev token only.
NEXT_PUBLIC_API_TOKEN=
# Until the API exposes resource and pipeline routes, name them here (JSON).
# NEXT_PUBLIC_BOOKING_RESOURCES=[{"id":"<uuid>","name":"Showroom appointments","kind":"showroom","timeZone":"America/New_York"}]
# NEXT_PUBLIC_PIPELINE={"id":"<uuid>","stages":[{"id":"<uuid>","name":"Inquiry"}]}
NEXT_PUBLIC_BOOKING_RESOURCES=
NEXT_PUBLIC_PIPELINE=
