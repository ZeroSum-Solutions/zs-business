# API runtime. DATABASE_URL must log in as the unprivileged runtime role, never a superuser.
DATABASE_URL=postgres://zs_runtime@127.0.0.1:55432/zs_dev
# How access tokens are verified, required: hs256 (the Supabase JWT secret below) or jwks
# (asymmetric Supabase signing keys from JWT_JWKS_URL). Tokens must also carry a live
# session_id and come from a member of the tenant (seed:demo prints one; see README "Auth").
JWT_VERIFIER=hs256
# hs256 only: the HS256 secret (at least 32 characters). seed:demo signs its dev token with it.
# Replace it (for example with `openssl rand -hex 32`): the API and seed refuse this placeholder.
JWT_SECRET=replace-with-a-local-dev-secret-of-32-or-more-chars
# jwks only: https://<project>.supabase.co/auth/v1/.well-known/jwks.json (plain http only on loopback).
# JWT_JWKS_URL=
# Optional: required `iss` claim, for example https://<project>.supabase.co/auth/v1
# JWT_ISSUER=
# Longest accepted token lifetime in seconds; the default is 3600 (one hour). Local dev only:
# 604800 accepts the 7-day token that seed:demo prints. Never raise it in production.
JWT_MAX_TTL_SECONDS=604800
# Optional: how far a token's iat may lie ahead of this server's clock, 0 to 300 seconds; default 60.
# JWT_CLOCK_SKEW_SECONDS=60
# How a token's session is checked, required. local-stub asks the loopback auth stub that
# seed:demo installs, and only runs with a loopback DATABASE_URL. Hosted deploys use supabase,
# which asks Supabase Auth (GET /auth/v1/user) and needs SUPABASE_URL and SUPABASE_ANON_KEY.
SESSION_CHECK=local-stub
# supabase only: https://<project>.supabase.co and the project's anon (publishable) key.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# supabase only: seconds a live answer is reused, 0 to 30; default 5. Sign-out bites within it.
# SESSION_CACHE_SECONDS=5
# Comma-separated browser origins allowed by CORS (the dashboard dev server).
ALLOWED_ORIGINS=http://localhost:3000
PORT=8787
# Public booking pages and the widget (docs/requirements/public-intake.md). Signs the page keys
# that client websites embed; at least 32 characters, replace it (`openssl rand -hex 32`).
# Leave it unset to turn the public routes off.
PUBLIC_BOOKING_KEY_SECRET=replace-with-a-booking-key-secret-of-32-or-more-chars
# During a rotation, the old secret still verifies existing keys:
# PUBLIC_BOOKING_KEY_PREVIOUS_SECRET=
# Origin of the hosted page and embed.js as browsers reach it; default http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://book.example.com
# Whose rate limit a public request spends. By default the socket address. Behind Vercel (and
# reachable only through it), name the header Vercel overwrites: x-vercel-forwarded-for or
# x-real-ip. Behind your own proxies, list their CIDRs instead; X-Forwarded-For then counts
# only from those peers. Not both.
# PUBLIC_CLIENT_IP_HEADER=x-vercel-forwarded-for
# PUBLIC_TRUSTED_PROXIES=10.0.0.0/8,fd00::/8
# Optional abuse-limit overrides (defaults: 10 writes and 300 reads per address per 10 min,
# 200 writes per tenant per hour).
# PUBLIC_RATE_ADDRESS_WRITES=10
# PUBLIC_RATE_ADDRESS_READS=300
# PUBLIC_RATE_TENANT_WRITES=200
# Where those limits count. postgres (default): one table every API instance shares, so the
# limits hold on Vercel. memory: this process only, for a loopback DATABASE_URL.
# PUBLIC_RATE_LIMIT_STORE=postgres
# One-click email unsubscribe (docs/requirements/delivery.md D-9). Verifies the List-Unsubscribe
# tokens in outgoing email; the delivery worker must sign with the same secret. At least 32
# characters, replace it (`openssl rand -hex 32`). Leave it unset to turn the routes off. The
# routes share PUBLIC_CLIENT_IP_HEADER / PUBLIC_TRUSTED_PROXIES and PUBLIC_RATE_ADDRESS_*.
# UNSUBSCRIBE_TOKEN_SECRET=replace-with-an-unsubscribe-token-secret-of-32-or-more-chars
# During a rotation, the old secret still verifies links in mail already sent:
# UNSUBSCRIBE_TOKEN_PREVIOUS_SECRET=
# Resend webhook (docs/requirements/resend.md R-7, R-8). The signing secret of the endpoint you
# add in Resend for POST /webhooks/resend, as Resend shows it (whsec_ then base64). Bounces and
# complaints then suppress the address. Leave it unset to turn the route off.
# RESEND_WEBHOOK_SECRET=whsec_replace-with-the-endpoint-signing-secret
# During a rotation, the old secret still verifies events Resend signed with it:
# RESEND_WEBHOOK_PREVIOUS_SECRET=
# Twilio webhooks (docs/requirements/twilio.md T-6, T-8): status callbacks and inbound
# STOP/START/HELP. Leave TWILIO_AUTH_TOKEN unset to turn the routes off.
# TWILIO_AUTH_TOKEN=
# TWILIO_PREVIOUS_AUTH_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_WEBHOOK_BASE_URL=https://api.example.com
# TWILIO_KEYWORD_REPLIES=provider
# Delivery runner (docs/requirements/resend.md R-9): the Vercel function GET /cron/delivery and
# `pnpm delivery:worker`. Off unless DELIVERY_WORKER=on; off needs nothing else.
# DELIVERY_WORKER=off
# CRON_SECRET=replace-with-a-cron-secret-of-32-or-more-chars
# A login that may SET ROLE service_role (not the runtime login). Shares DATABASE_CA_CERT.
# DELIVERY_DATABASE_URL=
# DELIVERY_PRICE_EMAIL=
# DELIVERY_PRICE_SMS_SEGMENT=
# DELIVERY_CURRENCY=usd
# DELIVERY_UNSUBSCRIBE_BASE_URL=https://api.example.com/public/v1/unsubscribe
# RESEND_API_KEY=
# RESEND_FROM=
# RESEND_REPLY_TO=
# SMS (twilio.md T-9): SMS_PROVIDER=twilio with TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID and
# TWILIO_API_KEY_SECRET (or TWILIO_AUTH_TOKEN) and TWILIO_WEBHOOK_BASE_URL. Unset refuses SMS.
# SMS_PROVIDER=none
# Optional tuning: DELIVERY_WORKER_ID, DELIVERY_RUN_BUDGET_MS (20000), DELIVERY_CLAIM_LIMIT (2),
# DELIVERY_PROVIDER_TIMEOUT_MS (5000), DELIVERY_INTERVAL_MS (15000, Node worker only).
# Build time only: DELIVERY_CRON_SCHEDULE adds the Vercel cron (unset, no cron).
# Stripe wallet top-ups (docs/requirements/stripe.md S-9). All or none: with none set, top-ups
# and POST /webhooks/stripe are off. STRIPE_LIVEMODE must match the key's mode.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_WEBHOOK_PREVIOUS_SECRET=
# STRIPE_LIVEMODE=false
# STRIPE_SUCCESS_URL=https://app.example.com/billing?topup=paid
# STRIPE_CANCEL_URL=https://app.example.com/billing?topup=cancelled
# Optional: STRIPE_CURRENCY (usd), STRIPE_TOPUP_MIN (500), STRIPE_TOPUP_MAX (50000), minor units;
# STRIPE_API_VERSION (the account default), STRIPE_BASE_URL.
# Billing runner (S-8): the Vercel function GET /cron/billing and `pnpm billing:worker`. Off
# unless BILLING_WORKER=on. It shares CRON_SECRET and DATABASE_CA_CERT.
# BILLING_WORKER=off
# A login that may SET ROLE service_role (not the runtime login).
# BILLING_DATABASE_URL=
# Optional tuning: BILLING_CLAIM_LIMIT (50), BILLING_RUN_BUDGET_MS (20000), BILLING_INTERVAL_MS
# (30000, Node worker only). Build time only: BILLING_CRON_SCHEDULE adds the Vercel cron.
# Google Calendar busy sync (docs/requirements/google-calendar.md G-12). All or none: with none
# set, POST /v1/calendar/google/connect, GET /oauth/google/callback and
# POST /webhooks/google/calendar are off. Secrets are 32+ characters.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://api.example.com/oauth/google/callback
# GOOGLE_RETURN_URL=https://app.example.com/settings/calendar
# GOOGLE_STATE_SECRET=
# GOOGLE_STATE_PREVIOUS_SECRET=
# Base64 DER SPKI of the X25519 sealing key; the calendar runner holds the private half.
# GOOGLE_TOKEN_PUBLIC_KEY=
# GOOGLE_CHANNEL_SECRET=
# Optional, for tests: GOOGLE_OAUTH_BASE_URL, GOOGLE_TOKEN_BASE_URL, GOOGLE_API_BASE_URL.
# Calendar runner (G-6..G-10): the Vercel function GET /cron/calendar and `pnpm calendar:worker`.
# Off unless CALENDAR_WORKER=on. It shares CRON_SECRET, DATABASE_CA_CERT, GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET and GOOGLE_CHANNEL_SECRET.
# CALENDAR_WORKER=off
# A login that may SET ROLE service_role (not the runtime login).
# CALENDAR_DATABASE_URL=
# Base64 DER PKCS#8 of the X25519 key; only the calendar runner holds it.
# GOOGLE_TOKEN_PRIVATE_KEY=
# GOOGLE_WEBHOOK_URL=https://api.example.com/webhooks/google/calendar
# GOOGLE_EVENT_TITLE=Booked
# Optional tuning: CALENDAR_RUN_BUDGET_MS (20000), CALENDAR_INTERVAL_MS (60000, Node worker only).
# Build time only: CALENDAR_CRON_SCHEDULE adds the Vercel cron.
# Activepieces (docs/requirements/activepieces.md W-14). Unset turns the owner routes under
# /v1/integrations/activepieces and the flow routes under /integrations/activepieces/v1 off.
# The same key goes to the API and the webhook worker; it derives every signing secret and token.
# ACTIVEPIECES_KEY_SECRET=replace-with-an-activepieces-key-secret-of-32-or-more-chars
# During a rotation, the old key still verifies tokens and still signs alongside the new one:
# ACTIVEPIECES_KEY_PREVIOUS_SECRET=
# Local development only (refused unless the database is loopback): receivers on http://127.0.0.1.
# ACTIVEPIECES_ALLOW_LOOPBACK=off
# Webhook worker: the Vercel function GET /cron/activepieces and `pnpm activepieces:worker`.
# Off unless ACTIVEPIECES_WEBHOOK_WORKER=on; off needs nothing else. Shares CRON_SECRET.
# ACTIVEPIECES_WEBHOOK_WORKER=off
# A login that may SET ROLE service_role (not the runtime login). Shares DATABASE_CA_CERT.
# ACTIVEPIECES_DATABASE_URL=
# Optional tuning: ACTIVEPIECES_WORKER_ID, ACTIVEPIECES_RUN_BUDGET_MS (20000), ACTIVEPIECES_CLAIM_LIMIT (2),
# ACTIVEPIECES_REQUEST_TIMEOUT_MS (5000), ACTIVEPIECES_MAX_ATTEMPTS (8),
# ACTIVEPIECES_INTERVAL_MS (15000, Node worker only).
# Build time only: ACTIVEPIECES_CRON_SCHEDULE adds the Vercel cron (unset, no cron).
