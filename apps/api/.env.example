# API runtime. DATABASE_URL must log in as the unprivileged runtime role, never a superuser.
DATABASE_URL=postgres://zs_runtime@127.0.0.1:55432/zs_dev
# How access tokens are verified, required: hs256 (the Supabase JWT secret below) or jwks
# (asymmetric Supabase signing keys from JWT_JWKS_URL). Tokens must also carry a live
# session_id and come from a member of the tenant (seed:demo prints one; see README "Auth").
JWT_VERIFIER=hs256
# hs256 only: the HS256 secret (at least 32 characters). seed:demo signs its dev token with it.
# Replace it (for example with `openssl rand -hex 32`): the API and seed refuse this placeholder.
JWT_SECRET=replace-with-a-local-dev-secret-of-32-or-more-chars
# jwks only: https://<project>.supabase.co/auth/v1/.well-known/jwks.json (plain http only on loopback).
# JWT_JWKS_URL=
# Optional: required `iss` claim, for example https://<project>.supabase.co/auth/v1
# JWT_ISSUER=
# Longest accepted token lifetime in seconds; the default is 3600 (one hour). Local dev only:
# 604800 accepts the 7-day token that seed:demo prints. Never raise it in production.
JWT_MAX_TTL_SECONDS=604800
# Optional: how far a token's iat may lie ahead of this server's clock, 0 to 300 seconds; default 60.
# JWT_CLOCK_SKEW_SECONDS=60
# How a token's session is checked, required. local-stub asks the loopback auth stub that
# seed:demo installs, and only runs with a loopback DATABASE_URL. Hosted deploys use supabase,
# which asks Supabase Auth (GET /auth/v1/user) and needs SUPABASE_URL and SUPABASE_ANON_KEY.
SESSION_CHECK=local-stub
# supabase only: https://<project>.supabase.co and the project's anon (publishable) key.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# supabase only: seconds a live answer is reused, 0 to 30; default 5. Sign-out bites within it.
# SESSION_CACHE_SECONDS=5
# Comma-separated browser origins allowed by CORS (the dashboard dev server).
ALLOWED_ORIGINS=http://localhost:3000
PORT=8787
# Public booking pages and the widget (docs/requirements/public-intake.md). Signs the page keys
# that client websites embed; at least 32 characters, replace it (`openssl rand -hex 32`).
# Leave it unset to turn the public routes off.
PUBLIC_BOOKING_KEY_SECRET=replace-with-a-booking-key-secret-of-32-or-more-chars
# During a rotation, the old secret still verifies existing keys:
# PUBLIC_BOOKING_KEY_PREVIOUS_SECRET=
# Origin of the hosted page and embed.js as browsers reach it; default http://localhost:<PORT>.
# PUBLIC_BASE_URL=https://book.example.com
# Whose rate limit a public request spends. By default the socket address. Behind Vercel (and
# reachable only through it), name the header Vercel overwrites: x-vercel-forwarded-for or
# x-real-ip. Behind your own proxies, list their CIDRs instead; X-Forwarded-For then counts
# only from those peers. Not both.
# PUBLIC_CLIENT_IP_HEADER=x-vercel-forwarded-for
# PUBLIC_TRUSTED_PROXIES=10.0.0.0/8,fd00::/8
# Optional abuse-limit overrides (defaults: 10 writes and 300 reads per address per 10 min,
# 200 writes per tenant per hour).
# PUBLIC_RATE_ADDRESS_WRITES=10
# PUBLIC_RATE_ADDRESS_READS=300
# PUBLIC_RATE_TENANT_WRITES=200
# Where those limits count. postgres (default): one table every API instance shares, so the
# limits hold on Vercel. memory: this process only, for a loopback DATABASE_URL.
# PUBLIC_RATE_LIMIT_STORE=postgres
