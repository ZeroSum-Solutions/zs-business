{
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "25"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
